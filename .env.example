# ==============================================================================
# AI Virtual Microphone - Environment Configuration Template
# Copy this file to .env and fill in your Gemini API key:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini API Credentials & Model
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live bidirectional audio model
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Default voice when accent conversion is off (Puck, Charon, Aoede, Fenrir, Kore)
GEMINI_VOICE=Puck

# ------------------------------------------------------------------------------
# 2. Audio Hardware & Virtual Devices
# ------------------------------------------------------------------------------
# Physical microphone name, index, or substring (e.g. 'alsa_input', 'default')
# Set to 'alsa_input' to prevent loopback if system default is set to virtual mic.
INPUT_DEVICE=alsa_input

# Output monitoring device (default or index)
OUTPUT_DEVICE=default

# Virtual sink where converted audio is written.
# On Linux, setup with: ./scripts/setup_virtual_mic.sh (defaults to 'ai_mic' or 'US_Voice_Sink')
VIRTUAL_MIC_DEVICE=US_Voice_Sink

# ------------------------------------------------------------------------------
# 3. Audio Streaming Parameters
# ------------------------------------------------------------------------------
# Input audio sample rate (Gemini Live expects 16000 or 24000)
SAMPLE_RATE=16000

# Virtual mic sink sample rate (standard PulseAudio / PipeWire is 48000)
VIRTUAL_MIC_SAMPLE_RATE=48000

CHANNELS=1
CHUNK_SIZE=2048

# ------------------------------------------------------------------------------
# 4. Accent & Tone Conversion Settings
# ------------------------------------------------------------------------------
# If true, Gemini rewrites & converts speech accent. If false, verbatim relay mode.
ENABLE_ACCENT_CONVERSION=true

# Target accent: american | british | australian | indian | neutral
TARGET_ACCENT=american

# Speaker's source accent hint (e.g. indian, chinese, spanish, french)
SOURCE_ACCENT=indian

# Tone / register: professional | friendly | casual | formal | empathetic
ACCENT_MODE=professional

# Output speech language
TARGET_LANGUAGE=english

# ------------------------------------------------------------------------------
# 5. Voice Activity Detection / Noise Gate
# ------------------------------------------------------------------------------
ENABLE_NOISE_GATE=true
NOISE_GATE_THRESHOLD_DB=10.0
NOISE_GATE_HANGOVER_MS=300.0

# ------------------------------------------------------------------------------
# 6. Logging
# ------------------------------------------------------------------------------
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
